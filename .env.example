# =========================================================
# AI Research Scientist — Environment Variables
# Copy this file to .env and fill in the keys you have.
# You do NOT need every key: the provider router will skip
# any provider whose key is missing and fall back to the
# next one in config/config.yaml -> llm.provider_priority.
# =========================================================


GROQ_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Hugging Face Inference API (https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=

# Ollama — local inference, no API key required.
# Only change this if Ollama runs on a different host/port.
OLLAMA_BASE_URL=http://localhost:11434
